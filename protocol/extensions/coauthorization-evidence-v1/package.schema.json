{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentguard.local/extensions/coauthorization-evidence-v1/package.schema.json",
  "title": "AgentGuard Coauthorization Evidence Package V1",
  "$comment": "Public signed evidence and the complete genesis-to-selected-checkpoint prefix. No keys, trust pins, checkpoint, live state or execution permission may come from this package.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "authorization_evidence", "audit_events"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "record_type": { "const": "COAUTHORIZATION_EVIDENCE_PACKAGE_V1" },
    "authorization_evidence": {
      "$ref": "https://agentguard.local/extensions/coauthorization-v1/authorization-audit-evidence.schema.json"
    },
    "audit_events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "oneOf": [
          { "$ref": "https://agentguard.local/schemas/audit-event.schema.json" },
          { "$ref": "https://agentguard.local/extensions/coauthorization-v1/audit-event-v2.schema.json" },
          { "$ref": "https://agentguard.local/extensions/coauthorization-v1/audit-event-v3.schema.json" }
        ]
      }
    }
  }
}
