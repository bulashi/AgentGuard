{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentguard.local/extensions/coauthorization-evidence-v1/revocation-verified-result.schema.json",
  "title": "AgentGuard Scoped Revocation Evidence Verification Result V1",
  "$comment": "Output of an actual successful verification only; not a current permission, independent proof of a database commit, trusted wall clock, or signatures of all other roots.",
  "type": "object", "additionalProperties": false,
  "required": [
    "schema_version", "verification_scope", "verified", "authorization_verification",
    "revocation_event_id", "source_kind", "source_identifier", "capture_kind", "observed_at_claim", "captured_at_claim",
    "page_count", "matched_root_count", "created_root_revocation_count", "selected_root_revocation_created",
    "selected_root_revoked_at_claim", "audit_event_sequences", "package_sha256",
    "proves_complete_recorded_pages", "authorizes_execution", "proves_current_revocation", "proves_atomic_state_change",
    "proves_other_root_signatures", "proves_real_principal_independence", "proves_business_side_effects"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "verification_scope": { "const": "SELECTED_ROOT_REVOCATION_AND_COMPLETE_PINNED_OBSERVATION" },
    "verified": { "const": true },
    "authorization_verification": { "$ref": "verified-result.schema.json" },
    "revocation_event_id": { "$ref": "https://agentguard.local/schemas/common.schema.json#/$defs/positiveSafeInteger" },
    "source_kind": { "enum": ["APPROVAL_KEY_REVOKED", "APPROVAL_KEY_COMPROMISED", "APPROVAL_POLICY_REVOKED", "AUTHORIZATION_WITHDRAWN"] },
    "source_identifier": { "$ref": "https://agentguard.local/schemas/common.schema.json#/$defs/identifier" },
    "capture_kind": { "enum": ["TRANSACTIONAL_CAPTURE", "LEGACY_OBSERVATION_LINK"] },
    "observed_at_claim": { "$ref": "https://agentguard.local/schemas/common.schema.json#/$defs/timestamp" },
    "captured_at_claim": { "$ref": "https://agentguard.local/schemas/common.schema.json#/$defs/timestamp" },
    "page_count": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "matched_root_count": { "$ref": "https://agentguard.local/schemas/common.schema.json#/$defs/nonNegativeSafeInteger" },
    "created_root_revocation_count": { "$ref": "https://agentguard.local/schemas/common.schema.json#/$defs/nonNegativeSafeInteger" },
    "selected_root_revocation_created": { "type": "boolean" },
    "selected_root_revoked_at_claim": { "$ref": "https://agentguard.local/schemas/common.schema.json#/$defs/timestamp" },
    "audit_event_sequences": {
      "type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true,
      "items": { "$ref": "https://agentguard.local/schemas/common.schema.json#/$defs/positiveSafeInteger" }
    },
    "package_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "proves_complete_recorded_pages": { "const": true },
    "authorizes_execution": { "const": false },
    "proves_current_revocation": { "const": false },
    "proves_atomic_state_change": { "const": false },
    "proves_other_root_signatures": { "const": false },
    "proves_real_principal_independence": { "const": false },
    "proves_business_side_effects": { "const": false }
  }
}
