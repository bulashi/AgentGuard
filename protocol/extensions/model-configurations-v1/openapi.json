{
  "openapi": "3.1.0",
  "info": {
    "title": "AgentGuard Local Model Configuration Extension",
    "version": "1.0.0",
    "description": "Local same-origin configuration. Credentials are write-only. The frozen signed capability and execution schemas are unchanged."
  },
  "paths": {
    "/api/model-configurations": {
      "get": {
        "summary": "Configurations",
        "operationId": "configurations_api_model_configurations_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigurationList"
                }
              }
            }
          }
        }
      }
    },
    "/api/model-configurations/default": {
      "patch": {
        "summary": "Select",
        "operationId": "select_api_model_configurations_default_patch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectConfiguration"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicModelConfiguration"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/model-configurations/{identifier}": {
      "put": {
        "summary": "Save",
        "operationId": "save_api_model_configurations__identifier__put",
        "parameters": [
          {
            "name": "identifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Identifier"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicModelConfiguration"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete",
        "operationId": "delete_api_model_configurations__identifier__delete",
        "parameters": [
          {
            "name": "identifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Identifier"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeletedConfiguration"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/model-configurations/{identifier}/test": {
      "post": {
        "summary": "Test",
        "operationId": "test_api_model_configurations__identifier__test_post",
        "parameters": [
          {
            "name": "identifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Identifier"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TestConfiguration"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelConnectionResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/operator-session": {
      "post": {
        "summary": "Operator Session",
        "operationId": "operator_session_api_operator_session_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OperatorSessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperatorSessionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConfigurationList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/PublicModelConfiguration"
            },
            "type": "array",
            "title": "Items"
          },
          "default_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Default Id"
          },
          "supported_api_modes": {
            "items": {
              "type": "string",
              "const": "chat_completions"
            },
            "type": "array",
            "title": "Supported Api Modes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items",
          "default_id",
          "supported_api_modes"
        ],
        "title": "ConfigurationList"
      },
      "DeletedConfiguration": {
        "properties": {
          "deleted": {
            "type": "boolean",
            "title": "Deleted"
          },
          "id": {
            "type": "string",
            "title": "Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "deleted",
          "id"
        ],
        "title": "DeletedConfiguration"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ModelConnectionResult": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL"
            ],
            "title": "Status"
          },
          "model_requested": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Requested"
          },
          "model_returned": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Returned"
          },
          "duration_ms": {
            "type": "integer",
            "title": "Duration Ms"
          },
          "reason_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason Code"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "duration_ms"
        ],
        "title": "ModelConnectionResult"
      },
      "OperatorSessionRequest": {
        "properties": {
          "launch_token": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "format": "password",
            "title": "Launch Token",
            "writeOnly": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "launch_token"
        ],
        "title": "OperatorSessionRequest"
      },
      "OperatorSessionResponse": {
        "properties": {
          "authenticated": {
            "type": "boolean",
            "title": "Authenticated"
          }
        },
        "type": "object",
        "required": [
          "authenticated"
        ],
        "title": "OperatorSessionResponse"
      },
      "ProfileInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "provider_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
            "title": "Provider Id"
          },
          "base_url": {
            "type": "string",
            "maxLength": 512,
            "minLength": 8,
            "title": "Base Url"
          },
          "api_mode": {
            "type": "string",
            "const": "chat_completions",
            "title": "Api Mode",
            "default": "chat_completions"
          },
          "model": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
            "title": "Model"
          },
          "timeout_seconds": {
            "type": "integer",
            "maximum": 300.0,
            "minimum": 5.0,
            "title": "Timeout Seconds",
            "default": 120
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "default": true
          },
          "api_key": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1024
              },
              {
                "type": "null"
              }
            ],
            "format": "password",
            "title": "Api Key",
            "writeOnly": true
          },
          "set_default": {
            "type": "boolean",
            "title": "Set Default",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "provider_id",
          "base_url",
          "model"
        ],
        "title": "ProfileInput"
      },
      "PublicModelConfiguration": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "provider_id": {
            "type": "string",
            "title": "Provider Id"
          },
          "base_url": {
            "type": "string",
            "title": "Base Url"
          },
          "api_mode": {
            "type": "string",
            "const": "chat_completions",
            "title": "Api Mode"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "timeout_seconds": {
            "type": "integer",
            "title": "Timeout Seconds"
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          },
          "has_key": {
            "type": "boolean",
            "title": "Has Key"
          },
          "is_default": {
            "type": "boolean",
            "title": "Is Default"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "provider_id",
          "base_url",
          "api_mode",
          "model",
          "timeout_seconds",
          "enabled",
          "has_key",
          "is_default"
        ],
        "title": "PublicModelConfiguration"
      },
      "SelectConfiguration": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
            "title": "Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id"
        ],
        "title": "SelectConfiguration"
      },
      "TestConfiguration": {
        "properties": {
          "confirm_cloud_call": {
            "type": "boolean",
            "title": "Confirm Cloud Call"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "confirm_cloud_call"
        ],
        "title": "TestConfiguration"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
