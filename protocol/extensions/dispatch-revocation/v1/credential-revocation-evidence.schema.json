{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentguard.local/extensions/dispatch-revocation/v1/credential-revocation-evidence.schema.json",
  "title": "CredentialRevocationEvidenceV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "credential_id", "credential_type", "parent_credential_id", "task_id", "revoked_at", "revoked_by", "reason"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "CREDENTIAL_REVOKED_V1"},
    "credential_id": {"$ref": "https://agentguard.local/schemas/common.schema.json#/$defs/identifier"},
    "credential_type": {"enum": ["ROOT", "DELEGATION"]},
    "parent_credential_id": {"$ref": "https://agentguard.local/schemas/common.schema.json#/$defs/nullableIdentifier"},
    "task_id": {"$ref": "https://agentguard.local/schemas/common.schema.json#/$defs/identifier"},
    "revoked_at": {"$ref": "https://agentguard.local/schemas/common.schema.json#/$defs/timestamp"},
    "revoked_by": {"type": "string", "minLength": 1, "maxLength": 128},
    "reason": {"type": "string", "minLength": 1, "maxLength": 256}
  }
}
