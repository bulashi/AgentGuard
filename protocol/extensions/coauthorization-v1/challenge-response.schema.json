{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentguard.local/extensions/coauthorization-v1/challenge-response.schema.json",
  "title": "AgentGuard Coauthorization V1 Challenge Response",
  "$comment": "Source contracts: backend/coauthorization/contracts.py:ChallengeResponse, TrustedTask and the four RootCapability variants. Capability definitions are local because the extension SchemaStore does not register frozen protocol/schemas resources. Hash and cross-field equality require semantic verification outside JSON Schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "challenge_status", "payload", "approval_payload_hash",
    "task_capabilities", "signature_domain"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "challenge_status": { "type": "string", "const": "PENDING" },
    "payload": {
      "$ref": "https://agentguard.local/extensions/coauthorization-v1/approval-payload.schema.json"
    },
    "approval_payload_hash": {
      "$ref": "https://agentguard.local/extensions/coauthorization-v1/common.schema.json#/$defs/sm3Hex",
      "description": "SM3 of canonicalize(payload), using the frozen AgentGuard canonical JSON profile."
    },
    "task_capabilities": {
      "description": "The complete trusted task capabilities, with exactly one of each of the four v1 tools. payload.capabilities_hash must equal SM3(canonicalize({\"capabilities\": task_capabilities})); the wrapper preserves frozen capabilities set semantics. Resource bindings and refund limits must match the trusted task.",
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/ticketCapability" },
          { "$ref": "#/$defs/knowledgeCapability" },
          { "$ref": "#/$defs/refundCapability" },
          { "$ref": "#/$defs/notificationCapability" }
        ]
      },
      "allOf": [
        {
          "contains": { "$ref": "#/$defs/ticketCapability" },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": { "$ref": "#/$defs/knowledgeCapability" },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": { "$ref": "#/$defs/refundCapability" },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": { "$ref": "#/$defs/notificationCapability" },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "signature_domain": {
      "type": "string",
      "const": "AGENTGUARD|TASK_COAUTHORIZATION_APPROVAL|V1"
    }
  },
  "$defs": {
    "singleIdentifier": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "https://agentguard.local/extensions/coauthorization-v1/common.schema.json#/$defs/identifier"
      }
    },
    "singleBusinessIdentifier": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": { "$ref": "https://agentguard.local/extensions/coauthorization-v1/common.schema.json#/$defs/businessIdentifier" }
    },
    "emptyConstraints": {
      "type": "object",
      "additionalProperties": false
    },
    "ticketResources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticket_ids"],
      "properties": {
        "ticket_ids": { "$ref": "#/$defs/singleIdentifier" }
      }
    },
    "customerResources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["customer_ids"],
      "properties": {
        "customer_ids": { "$ref": "#/$defs/singleBusinessIdentifier" }
      }
    },
    "refundResources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticket_ids", "customer_ids"],
      "properties": {
        "ticket_ids": { "$ref": "#/$defs/singleIdentifier" },
        "customer_ids": { "$ref": "#/$defs/singleBusinessIdentifier" }
      }
    },
    "refundConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["single_max_fen"],
      "properties": {
        "single_max_fen": {
          "$ref": "https://agentguard.local/extensions/coauthorization-v1/common.schema.json#/$defs/safeInteger"
        }
      }
    },
    "notificationConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template_ids"],
      "properties": {
        "template_ids": { "$ref": "#/$defs/singleIdentifier" }
      }
    },
    "ticketCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "tool", "version", "resources", "constraints"],
      "properties": {
        "service": { "type": "string", "const": "ticket-service" },
        "tool": { "type": "string", "const": "ticket.read" },
        "version": { "type": "string", "const": "v1" },
        "resources": { "$ref": "#/$defs/ticketResources" },
        "constraints": { "$ref": "#/$defs/emptyConstraints" }
      }
    },
    "knowledgeCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "tool", "version", "resources", "constraints"],
      "properties": {
        "service": { "type": "string", "const": "knowledge-service" },
        "tool": { "type": "string", "const": "knowledge.read_associated" },
        "version": { "type": "string", "const": "v1" },
        "resources": { "$ref": "#/$defs/ticketResources" },
        "constraints": { "$ref": "#/$defs/emptyConstraints" }
      }
    },
    "refundCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "tool", "version", "resources", "constraints"],
      "properties": {
        "service": { "type": "string", "const": "refund-service" },
        "tool": { "type": "string", "const": "refund.create" },
        "version": { "type": "string", "const": "v1" },
        "resources": { "$ref": "#/$defs/refundResources" },
        "constraints": { "$ref": "#/$defs/refundConstraints" }
      }
    },
    "notificationCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "tool", "version", "resources", "constraints"],
      "properties": {
        "service": { "type": "string", "const": "notification-service" },
        "tool": { "type": "string", "const": "notification.send_template" },
        "version": { "type": "string", "const": "v1" },
        "resources": { "$ref": "#/$defs/customerResources" },
        "constraints": { "$ref": "#/$defs/notificationConstraints" }
      }
    }
  }
}
