{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentguard.local/extensions/coauthorization-v1/authorization-audit-evidence.schema.json",
  "title": "AgentGuard Coauthorization Root Authorization Audit Evidence V1",
  "$comment": "Structural contract only. The audit helper checks canonical SM3 hashes, bindings and times. Actual SM2 verification with trusted keys precedes audit construction in the Authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "tenant_id", "task_id", "challenge_id",
    "policy_revision", "approval_payload_hash", "bundle_hash", "signed_bundle",
    "root_credential_id", "root_credential_hash", "credential", "authorized_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "record_type": { "type": "string", "const": "COAUTH_ROOT_AUTHORIZED_V1" },
    "tenant_id": { "$ref": "common.schema.json#/$defs/businessIdentifier" },
    "task_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "challenge_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "policy_revision": { "$ref": "common.schema.json#/$defs/identifier" },
    "approval_payload_hash": { "$ref": "common.schema.json#/$defs/sm3Hex" },
    "bundle_hash": { "$ref": "common.schema.json#/$defs/sm3Hex" },
    "signed_bundle": { "$ref": "coauthorization-bundle.schema.json" },
    "root_credential_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "root_credential_hash": { "$ref": "common.schema.json#/$defs/sm3Hex" },
    "credential": {
      "$ref": "https://agentguard.local/schemas/capability-credential.schema.json",
      "properties": {
        "signature": { "$ref": "common.schema.json#/$defs/approvalSignature" }
      }
    },
    "authorized_at": { "$ref": "common.schema.json#/$defs/safeInteger" }
  }
}
