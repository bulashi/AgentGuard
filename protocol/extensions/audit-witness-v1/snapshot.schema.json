{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentguard.local/extensions/audit-witness-v1/snapshot.schema.json",
  "title": "Public complete audit prefix through the supplied signed checkpoint",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "record_type", "stream_id", "checkpoint_domain", "event_hash_domain", "source_head", "audit_events"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "AUDIT_WITNESS_SNAPSHOT_V1"},
    "stream_id": {"$ref": "https://agentguard.local/schemas/common.schema.json#/$defs/identifier"},
    "checkpoint_domain": {"const": "AGENTGUARD|AUDIT_CHECKPOINT|V1"},
    "event_hash_domain": {"const": "AGENTGUARD|AUDIT_EVENT_HASH|V1"},
    "source_head": {
      "type": "object", "additionalProperties": false,
      "required": ["latest_event_sequence", "latest_event_hash"],
      "properties": {
        "latest_event_sequence": {"$ref": "https://agentguard.local/schemas/common.schema.json#/$defs/positiveSafeInteger"},
        "latest_event_hash": {"$ref": "https://agentguard.local/schemas/common.schema.json#/$defs/sm3Hex"}
      }
    },
    "audit_events": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {"oneOf": [
        {"$ref": "https://agentguard.local/schemas/audit-event.schema.json"},
        {"$ref": "https://agentguard.local/extensions/coauthorization-v1/audit-event-v2.schema.json"},
        {"$ref": "https://agentguard.local/extensions/coauthorization-v1/audit-event-v3.schema.json"},
        {"$ref": "https://agentguard.local/extensions/dispatch-revocation/v1/audit-event-v4.schema.json"}
      ]}
    }
  }
}
