{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentguard.local/extensions/audit-witness-v1/witness-entry.schema.json",
  "title": "Immutable public audit witness entry",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "record_type", "witness_sequence", "previous_entry_sm3", "trust_context_sm3", "checkpoint", "snapshot", "observed_at", "entry_sm3"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "AUDIT_WITNESS_ENTRY_V1"},
    "witness_sequence": {"type": "integer", "minimum": 1, "maximum": 128},
    "previous_entry_sm3": {"$ref": "https://agentguard.local/schemas/common.schema.json#/$defs/sm3Hex"},
    "trust_context_sm3": {"$ref": "https://agentguard.local/schemas/common.schema.json#/$defs/sm3Hex"},
    "checkpoint": {"$ref": "checkpoint.schema.json"},
    "snapshot": {"$ref": "snapshot.schema.json"},
    "observed_at": {"$ref": "https://agentguard.local/schemas/common.schema.json#/$defs/timestamp"},
    "entry_sm3": {"$ref": "https://agentguard.local/schemas/common.schema.json#/$defs/sm3Hex"}
  }
}
