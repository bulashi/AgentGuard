{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentguard.local/schemas/request-context.schema.json",
  "title": "RequestContext",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "execution_id", "request_id", "request_hash", "credential_chain_hash", "tenant_id",
    "task_id", "holder_agent_id", "holder_key_id", "tool_service", "tool_name",
    "tool_version", "canonical_parameters", "parameter_hash", "business_action_id",
    "issued_at", "established_at"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "execution_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "request_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "request_hash": { "$ref": "common.schema.json#/$defs/sm3Hex" },
    "credential_chain_hash": { "$ref": "common.schema.json#/$defs/sm3Hex" },
    "tenant_id": { "$ref": "common.schema.json#/$defs/businessIdentifier" },
    "task_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "holder_agent_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "holder_key_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "tool_service": { "$ref": "common.schema.json#/$defs/serviceName" },
    "tool_name": { "$ref": "common.schema.json#/$defs/toolName" },
    "tool_version": { "$ref": "common.schema.json#/$defs/toolVersion" },
    "canonical_parameters": { "$ref": "common.schema.json#/$defs/canonicalParameters" },
    "parameter_hash": { "$ref": "common.schema.json#/$defs/sm3Hex" },
    "business_action_id": { "$ref": "common.schema.json#/$defs/nullableIdentifier" },
    "issued_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "established_at": { "$ref": "common.schema.json#/$defs/timestamp" }
  }
}
