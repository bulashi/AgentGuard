{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentguard.local/schemas/request-envelope.schema.json",
  "title": "RequestEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "credential_chain", "task_id", "tool_service", "tool_name",
    "tool_version", "canonical_parameters", "request_id", "issued_at", "holder_key_id",
    "business_action_id", "holder_proof"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "credential_chain": {
      "type": "array",
      "minItems": 1,
      "maxItems": 17,
      "items": {
        "oneOf": [
          { "$ref": "capability-credential.schema.json" },
          { "$ref": "delegation-credential.schema.json" }
        ]
      }
    },
    "task_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "tool_service": { "$ref": "common.schema.json#/$defs/serviceName" },
    "tool_name": { "$ref": "common.schema.json#/$defs/toolName" },
    "tool_version": { "$ref": "common.schema.json#/$defs/toolVersion" },
    "canonical_parameters": { "$ref": "common.schema.json#/$defs/canonicalParameters" },
    "request_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "issued_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "holder_key_id": { "$ref": "common.schema.json#/$defs/identifier" },
    "business_action_id": { "$ref": "common.schema.json#/$defs/nullableIdentifier" },
    "holder_proof": { "$ref": "holder-proof.schema.json" }
  }
}

