{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentguard.local/schemas/capability-credential.schema.json",
  "title": "CapabilityCredential",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "signature"],
  "properties": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "credential_id", "credential_type", "issuer", "holder",
        "tenant_id", "task_id", "verifier_audience", "capabilities", "quotas",
        "not_before", "expires_at", "delegation_depth", "parent_credential_id",
        "parent_credential_hash", "issued_at"
      ],
      "properties": {
        "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
        "credential_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "credential_type": { "type": "string", "const": "ROOT" },
        "issuer": { "$ref": "common.schema.json#/$defs/issuer" },
        "holder": { "$ref": "common.schema.json#/$defs/holder" },
        "tenant_id": { "$ref": "common.schema.json#/$defs/businessIdentifier" },
        "task_id": { "$ref": "common.schema.json#/$defs/identifier" },
        "verifier_audience": { "type": "string", "const": "secure-tool-gateway" },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/capability" }
        },
        "quotas": { "$ref": "common.schema.json#/$defs/quotas" },
        "not_before": { "$ref": "common.schema.json#/$defs/timestamp" },
        "expires_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "delegation_depth": { "type": "integer", "minimum": 0, "maximum": 16 },
        "parent_credential_id": { "type": "null" },
        "parent_credential_hash": { "type": "null" },
        "issued_at": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    },
    "signature": { "$ref": "common.schema.json#/$defs/signature" }
  }
}
